# ===== Server Config =====
PORT=5000

# ===== JWT =====
JWT_SECRET=your_jwt_secret_here

# ===== Pinata (IPFS) =====
PINATA_JWT=your_pinata_jwt_here
PINATA_GATEWAY=gateway.pinata.cloud

# ===== PostgreSQL Database =====
DATABASE_URL="postgresql://postgres:password@localhost:5432/blockchain_cert?schema=public"

# ===== Blockchain (Smart Contract) =====
CONTRACT_ADDRESS=0x...
NETWORK=hardhat
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
ADMIN_PRIVATE_KEY=0x...
ADMIN_ADDRESS=0x...

# ===== Optional =====
IPFS_FETCH_TIMEOUT_MS=10000
IP_HASH_SALT=dev-ip-salt
MAX_CERTIFICATE_FILE_SIZE_MB=10
API_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
VERIFY_RATE_LIMIT_MAX=60
DEBUG_REQUEST_BODY=false
